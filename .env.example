# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# Find both values in Supabase -> Project Settings -> API.
#
# Only VITE_* variables are exposed to the browser by Vite. That is intentional
# here: the anon key is designed to be public. Security comes from Row Level
# Security (RLS) policies on the database, not from hiding this key.
#
# NEVER put the service_role key in this file or anywhere in this repo.
# It bypasses RLS entirely and this repo is public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
